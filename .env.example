GATEWAY_ADMIN_KEY=change-me-admin-key
GATEWAY_DB=/tmp/gateway.db
# provider keys (set the ones you have)
GATEWAY_GROQ_KEY=
GATEWAY_CEREBRAS_KEY=
GATEWAY_DEEPINFRA_KEY=
GATEWAY_TOGETHER_KEY=
GATEWAY_FIREWORKS_KEY=
GATEWAY_OPENAI_KEY=
GATEWAY_ANTHROPIC_KEY=
GATEWAY_HF_KEY=
HF_TOKEN=
# stripe (for billing)
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_USD=10

# x402 machine-payable top-up (optional; requires a Base Sepolia receiving wallet)
# Set X402_PAYTO to your public Base wallet address to enable POST /v1/x402/topup
X402_ENABLED=false
X402_PAYTO=
X402_PRICE_USD=0.001
X402_CHAIN_ID=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RPC_URL=https://sepolia.base.org
