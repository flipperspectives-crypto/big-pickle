GATEWAY_ADMIN_KEY=change-me-admin-key
GATEWAY_DB=/tmp/gateway.db
# provider keys (set the ones you have)
GATEWAY_GROQ_KEY=
GATEWAY_CEREBRAS_KEY=
GATEWAY_DEEPINFRA_KEY=
GATEWAY_TOGETHER_KEY=
GATEWAY_FIREWORKS_KEY=
GATEWAY_OPENAI_KEY=
GATEWAY_ANTHROPIC_KEY=
GATEWAY_HF_KEY=
HF_TOKEN=
# stripe (for billing)
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_USD=10

# x402 machine-payable top-up. Network is driven by X402_NETWORK_MODE; the chain,
# asset, facilitator, and RPC are derived from it (do NOT set them separately).
X402_ENABLED=false
X402_PAYTO=
X402_PRICE_USD=0.001

# X402_NETWORK_MODE MUST be "testnet" or "mainnet". Default is testnet.
# Mainnet uses REAL funds and is FAIL-CLOSED: it only advertises a mainnet
# challenge when BOTH CDP_API_KEY_ID and CDP_API_KEY_SECRET are present.
X402_NETWORK_MODE=testnet

# --- Testnet (default) is Base Sepolia; these are derived from X402_NETWORK_MODE ---
# X402_CHAIN_ID=eip155:84532
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_RPC_URL=https://sepolia.base.org

# --- Mainnet (Base mainnet, REAL MONEY) ---
# X402_CHAIN_ID=eip155:8453
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_RPC_URL=https://mainnet.base.org
# Requires CDP facilitator auth (NEVER put values here; export as secrets):
# CDP_API_KEY_ID=<secret>
# CDP_API_KEY_SECRET=<secret>
# WARNING: mainnet x402 spends real Base USDC. Do not enable unless intended.
